# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies - unanchored so this also catches backend/node_modules (and
# any other nested node_modules), not just the one at the repo root
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite
# /dist/ used to be ignored (a normal build artifact) - now deliberately
# tracked in git. The backend serves this folder directly to the public
# (see backend/index.js's express.static(dist) mount, for the customer QR
# ordering PWA) - committing it means a plain `git pull` on the server
# brings the built frontend along with the backend code, instead of
# needing a separate manual copy step every deploy. Run `npm run build`
# before committing whenever frontend source changes, so this never goes
# stale relative to src/.
dist-electron/

# electron-builder installer output (large - installers, unpacked builds, caches)
/release/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editor/IDE
.vscode/
.idea/

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files - never commit real secrets/connection strings; .env.example
# stays tracked since it has no real values
.env
.env.*
!.env.example

# WhatsApp/Baileys session credentials (backend/services/whatsappService.js)
# - as sensitive as a password, never belongs in git. Written next to
# wherever the backend process runs (till, or the server post-migration -
# see backend/README-deploy.md).
.auth_whatsapp/

# vercel
.vercel

# typescript
*.tsbuildinfo