# MongoDB Atlas connection string. Express connects to this directly -
# there is no separate local database and no sync layer anymore.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/masterpos?appName=Cluster23

# Used to sign/verify login tokens. Auto-generated into .env on first run
# if missing, but set it explicitly for anything beyond local dev.
JWT_SECRET=

PORT=5000
