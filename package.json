{
  "name": "pos-web",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-first POS system with offline support.",
  "author": "Ali Haider",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,BACKEND,ELECTRON -c blue,green,magenta \"npm:dev:vite\" \"npm:dev:backend\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:backend": "wait-on tcp:5173 && node backend/index.js",
    "dev:electron": "wait-on tcp:5173 tcp:5000 && cross-env ELECTRON_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:web": "concurrently \"vite\" \"node backend/index.js\"",
    "start:server": "node backend/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder --publish never",
    "electron:pack": "electron-builder --publish never",
    "electron:publish": "npm run build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps",
    "migrate": "node backend/scripts/migrateToMultiTenant.js",
    "reset-admin": "node backend/scripts/resetAdminPassword.js",
    "fix-admin-role": "node backend/scripts/fixSuperAdminRole.js",
    "export-menu": "node backend/scripts/exportMenuData.js",
    "import-menu": "node backend/scripts/importMenuData.js",
    "set-app-version": "node backend/scripts/setAppVersion.js",
    "backfill-tr-numbers": "node backend/scripts/backfillShopSequenceNumbers.js"
  },
  "build": {
    "appId": "com.pos.system",
    "productName": "POS System",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@whiskeysockets/**/*",
      "**/node_modules/pdf-to-printer/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json",
      "backend/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "haider7c",
        "repo": "pos-web-new",
        "private": true
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@reduxjs/toolkit": "^2.5.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "buffer": "^6.0.3",
    "cors": "^2.8.6",
    "dexie": "^4.4.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "mongoose": "^9.6.1",
    "pdf-to-printer": "^5.8.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.8.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "wait-on": "^9.0.5"
  }
}
